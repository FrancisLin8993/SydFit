OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-5.4-mini

# Copy the key from the Bark iOS app test URL.
BARK_DEVICE_KEY=your-bark-device-key
BARK_SERVER_URL=https://api.day.app
BARK_GROUP=Weather
BARK_LEVEL=active

# The job runs at 7:00 AM in this timezone.
SCHEDULE_TIMEZONE=Australia/Sydney

# Set to true to bypass the 7:00 AM guard and send immediately.
RUN_ON_START=false

# Langfuse Tracing (optional — leave blank to disable tracing)
# Get keys from Langfuse → Settings → API Keys
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com
