		"@openai/agents": "^0.12.0",
		"@opentelemetry/sdk-node": "^0.219.0",
		"google-auth-library": "^10.9.0",
		"headroom-ai": "^0.22.4",
		"hono": "^4.12.27",
		"openai": "^6.45.0",
		"zod": "^4.4.3"
