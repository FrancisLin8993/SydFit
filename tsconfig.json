{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"outDir": "dist",
		"rootDir": "src",
		"strict": false,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"allowJs": true, // ← new: lets tsc process .js files too
		"types": ["node"]
	},
	"include": ["src/**/*.ts", "src/**/*.js"], // ← include .js explicitly
	"exclude": ["node_modules", "dist"]
}
